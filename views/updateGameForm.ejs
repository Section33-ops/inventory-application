<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <form action="/game/<%= game.id %>/update" method="post">
      <label for="gameTitle">Title</label>
      <input
        type="text"
        name="gameTitle"
        id="gameTitle"
        value="<%= game.title %>"
        required
      />
      <label for="gameGenre">Genre</label>
      <select name="gameGenre" id="gameGenre">
        <option value="1" <%= game.genre_id === 1 ? 'selected' : '' %>>Platformer</option>
        <option value="2" <%= game.genre_id === 2 ? 'selected' : '' %>>Shoot 'Em Ups (Shmups)</option>
        <option value="3" <%= game.genre_id === 3 ? 'selected' : '' %>>RPG</option>
        <option value="4" <%= game.genre_id === 4 ? 'selected' : '' %>>Beat 'Em Ups</option>
        <option value="5" <%= game.genre_id === 5 ? 'selected' : '' %>>Action-Adventure</option>
        <option value="6" <%= game.genre_id === 6 ? 'selected' : '' %>>Arcade/Maze</option>
        <option value="7" <%= game.genre_id === 7 ? 'selected' : '' %>>Fighting</option>
        <option value="8" <%= game.genre_id === 8 ? 'selected' : '' %>>Run and Gun</option>
        <option value="9" <%= game.genre_id === 9 ? 'selected' : '' %>>Sports</option>
        <option value="10" <%= game.genre_id === 10 ? 'selected' : '' %>>Racing</option>
        <option value="11" <%= game.genre_id === 11 ? 'selected' : '' %>>Simulation</option>
        <option value="12" <%= game.genre_id === 12 ? 'selected' : '' %>>Strategy</option>
      </select>
      <label for="gameReleaseYear">Release Year</label>
      <input
        type="number"
        name="gameReleaseYear"
        id="gameReleaseYear"
        value="<%= game.release_year %>"
      />
      <label for="gameConsole">Console</label>
      <select name="gameConsole" id="gameConsole">
        <option value="1" <%= game.console_id === 1 ? 'selected' : '' %>>Atari 2600</option>
        <option value="2" <%= game.console_id === 2 ? 'selected' : '' %>>
          Nintendo Entertainment System (NES)
        </option>
        <option value="3" <%= game.console_id === 3 ? 'selected' : '' %>>Sega Master System</option>
        <option value="4" <%= game.console_id === 4 ? 'selected' : '' %>>Nintendo Game Boy</option>
        <option value="5" <%= game.console_id === 5 ? 'selected' : '' %>>Super Nintendo (SNES)</option>
        <option value="6" <%= game.console_id === 6 ? 'selected' : '' %>>Sega Genesis</option>
        <option value="7" <%= game.console_id === 7 ? 'selected' : '' %>>Sega Game Gear</option>
        <option value="8" <%= game.console_id === 8 ? 'selected' : '' %>>Sony PlayStation 1</option>
        <option value="9" <%= game.console_id === 9 ? 'selected' : '' %>>Nintendo 64</option>
        <option value="10" <%= game.console_id === 10 ? 'selected' : '' %>>Sega Saturn</option>
        <option value="11" <%= game.console_id === 11 ? 'selected' : '' %>>Game Boy Color</option>
        <option value="12" <%= game.console_id === 12 ? 'selected' : '' %>>Sony PlayStation 2</option>
        <option value="13" <%= game.console_id === 13 ? 'selected' : '' %>>Nintendo GameCube</option>
        <option value="14" <%= game.console_id === 14 ? 'selected' : '' %>>Original Xbox</option>
        <option value="15" <%= game.console_id === 15 ? 'selected' : '' %>>Sega Dreamcast</option>
        <option value="16" <%= game.console_id === 16 ? 'selected' : '' %>>Game Boy Advance</option>
        <option value="17" <%= game.console_id === 17 ? 'selected' : '' %>>Xbox 360</option>
        <option value="18" <%= game.console_id === 18 ? 'selected' : '' %>>Sony PlayStation 3</option>
        <option value="19" <%= game.console_id === 19 ? 'selected' : '' %>>Nintendo Wii</option>
        <option value="20" <%= game.console_id === 20 ? 'selected' : '' %>>Nintendo DS</option>
        <option value="21" <%= game.console_id === 21 ? 'selected' : '' %>>
          PlayStation Portable (PSP)
        </option>
      </select>
      <button type="submit">Update Game</button>
    </form>
  </body>
</html>
