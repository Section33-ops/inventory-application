<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <h1>My Retro Gaming</h1>

    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Title</th>
          <th>Genre</th>
          <th>Release Year</th>
          <th>Console</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% games.forEach(game => {%>
          <tr>
            <td><%= game.id %></td>
            <td><%= game.title %></td>
            <td><%= game.genre %></td>
            <td><%= game.release_year %></td>
            <td><%= game.console %></td>
            <td><a href="/game:<%= game.id %>/update">Update</a></td>
          </tr>
        <% });  %>
      </tbody>
    </table>
    <a href="/games/create">Add Game</a>
  </body>
</html>
