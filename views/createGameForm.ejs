<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <form action="/games/create" method="post">
      <label for="gameTitle">Title</label>
      <input type="text" name="gameTitle" id="gameTitle" required />
      <label for="gameGenre">Genre</label>
      <select name="gameGenre" id="gameGenre">
        <option value="">Select Genre</option>
        <option value="1">Platformer</option>
        <option value="2">Shoot 'Em Ups (Shmups)</option>
        <option value="3">RPG</option>
        <option value="4">Beat 'Em Ups</option>
        <option value="5">Action-Adventure</option>
        <option value="6">Arcade/Maze</option>
        <option value="7">Fighting</option>
        <option value="8">Run and Gun</option>
        <option value="9">Sports</option>
        <option value="10">Racing</option>
        <option value="11">Simulation</option>
        <option value="12">Strategy</option>
      </select>
      <label for="gameReleaseYear">Release Year</label>
      <input type="number" name="gameReleaseYear" id="gameReleaseYear" />
      <label for="gameConsole">Console</label>
      <select name="gameConsole" id="gameConsole">
        <option value="1">Atari 2600</option>
        <option value="2">Nintendo Entertainment System (NES)</option>
        <option value="3">Sega Master System</option>
        <option value="4">Nintendo Game Boy</option>
        <option value="5">Super Nintendo (SNES)</option>
        <option value="6">Sega Genesis</option>
        <option value="7">Sega Game Gear</option>
        <option value="8">Sony PlayStation 1</option>
        <option value="9">Nintendo 64</option>
        <option value="10">Sega Saturn</option>
        <option value="11">Game Boy Color</option>
        <option value="12">Sony PlayStation 2</option>
        <option value="13">Nintendo GameCube</option>
        <option value="14">Original Xbox</option>
        <option value="15">Sega Dreamcast</option>
        <option value="16">Game Boy Advance</option>
        <option value="17">Xbox 360</option>
        <option value="18">Sony PlayStation 3</option>
        <option value="19">Nintendo Wii</option>
        <option value="20">Nintendo DS</option>
        <option value="21">PlayStation Portable (PSP)</option>
      </select>
      <button type="submit">Add Game</button>
    </form>
    <a href="/">Back Home</a>
  </body>
</html>
