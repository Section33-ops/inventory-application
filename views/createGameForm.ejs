<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <form action="/games/create" method="post">
      <label for="gameTitle">Title</label>
      <input type="text" name="gameTitle" id="gameTitle" required />
      <label for="gameGenre">Genre</label>
      <input type="text" name="gameGenre" id="gameGenre" />
      <label for="gameReleaseYear">Release Year</label>
      <input type="text" name="gameReleaseYear" id="gameReleaseYear" />
      <label for="gameConsole">Console</label>
      <input type="text" name="gameConsole" id="gameConsole" required />
      <button type="submit">Add Game</button>
    </form>
    <a href="/">Back Home</a>
  </body>
</html>
